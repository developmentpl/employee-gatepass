# ---------- Server ----------
# Web app that employees open in the browser
APP_PORT=5123
# Backend API + eSSL machine communication (enter this port on the eSSL machine)
API_PORT=5124
# Time zone used for all gate-pass and attendance times
TZ=Asia/Kolkata
# Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# How long a login stays valid
JWT_EXPIRES=12h

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=harman_gatepass

# ---------- First admin (created automatically on first start) ----------
ADMIN_EMAIL=admin@harman.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Administrator
ADMIN_EMP_CODE=ADMIN001

# Password given to users created by the admin / bulk upload.
# Users are forced to change it on first login.
DEFAULT_USER_PASSWORD=Harman@123

# ---------- Microsoft (Entra ID / Office 365) login ----------
# Leave blank to hide the "Sign in with Microsoft" button.
# IT registers a "Single-page application" in Azure Portal > App registrations,
# adds the app URL (e.g. http://gatepass.harman.local:5123) as a Redirect URI,
# then copies the two IDs below.
MS_TENANT_ID=
MS_CLIENT_ID=

# ---------- Email notifications (optional) ----------
# Leave SMTP_HOST blank to disable emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Gate Pass <gatepass@harman.com>"
# Link put in emails
APP_URL=http://localhost:5123

# ---------- Online test site (Railway) — not used on-prem ----------
# Railway sets these itself or you add them in its Variables tab; do NOT add them on the plant server.
# MYSQL_URL=${{MySQL.MYSQL_URL}}   database (instead of DB_*)
# SEED_DEMO=true                    add demo employees on first start
# UPLOAD_DIR=/data/uploads          photo folder (defaults to the attached volume)
# SINGLE_PORT=true                  serve web app + API on PORT only (automatic on Railway)
